{
  "name": "curupira-legal/curupira-legal",
  "type": "project",
  "description": "SaaS brasileiro para contratos, cobrança, tributação e NFS-e.",
  "keywords": ["laravel", "inertia", "nfse", "brasil", "saas"],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "^2.0",
    "laravel/framework": "^12.0",
    "laravel/fortify": "^1.30",
    "laravel/horizon": "^5.35",
    "laravel/sanctum": "^4.0",
    "predis/predis": "^2.3"
  },
  "require-dev": {
    "laravel/pint": "^1.24",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^3.8",
    "pestphp/pest-plugin-laravel": "^3.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --force"],
    "lint": "pint --test",
    "test": "@php artisan test"
  },
  "extra": { "laravel": { "dont-discover": [] } },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
